# Atala Lab — cPanel Apache Configuration

Options -MultiViews
RewriteEngine On
RewriteBase /coding-for-kids/

# 404 handler
ErrorDocument 404 /coding-for-kids/404.html

# Ensure proper MIME types for JavaScript, JSON, CSS, and SVG
AddType application/javascript js mjs
AddType application/json json
AddType text/css css
AddType image/svg+xml svg

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching for static assets (_next)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
